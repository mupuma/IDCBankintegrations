# ZICB H2H agent: copy to .env and supply bank-approved values.
# Run from microservices/zicb-agent-service. No Redis or Sage variables required.
PORT=4001
APP_API_URL=http://127.0.0.1:3000
# Must match the portal ZICB_H2H_AGENT_KEY.
ZICB_H2H_AGENT_KEY=

# Each JSON key must match profileId in the portal ZICB_H2H_SOURCE_PROFILES.
# Use base URLs only; the client appends the channel service paths.
# Use credentials and HTTPS URLs issued for the same bank environment.
ZICB_H2H_PROFILES='{"institution-uat":{"clientId":"BANK_CLIENT_ID","clientSecret":"BANK_CLIENT_SECRET","authUrl":"https://AUTH_HOST:PORT","internalUrl":"https://INTERNAL_HOST:PORT","rtgsUrl":"https://RTGS_HOST:PORT","ddaccUrl":"https://DDACC_HOST:PORT"}}'

# Required for bank callback login and short-lived callback token signing.
# Agree username/password with ZICB; generate a local signing key of >=32 characters.
ZICB_H2H_WEBHOOK_USERNAME=
ZICB_H2H_WEBHOOK_PASSWORD=
ZICB_H2H_WEBHOOK_SIGNING_KEY=

# Optional diagnostics. Shared HTTP logging is enabled by default.
HTTP_LOG_ENABLED=true
HTTP_LOG_BODIES=true
HTTP_LOG_MAX_BODY_BYTES=262144
HTTP_LOG_BODY_TIMEOUT_MS=10000
# Used by the fallback H2H logger when shared HTTP logging is not installed.
ZICB_H2H_LOG_HTTP=true
ZICB_H2H_LOG_RAW_RESPONSES=false
# ZICB_H2H_ENABLED is unused: this service always starts in H2H mode.
