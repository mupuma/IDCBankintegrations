ZICB_H2H_ENABLED=false
PORT=4001
# Readable request/response blocks, enabled by default. Includes full beneficiary/payment data.
# Authorization headers and authentication bodies are excluded. Set false to disable.
ZICB_H2H_LOG_HTTP=true
# Temporary diagnostics: logs full non-auth response bodies, which may contain beneficiary data.
ZICB_H2H_LOG_RAW_RESPONSES=false
APP_API_URL=https://YOUR_PORTAL
ZICB_H2H_AGENT_KEY=
# Store these credentials in backend secrets, not in source control.
ZICB_H2H_PROFILES={"institution-uat":{"clientId":"BANK_CLIENT_ID","clientSecret":"BANK_CLIENT_SECRET","authUrl":"https://AUTH_HOST:PORT","internalUrl":"https://INTERNAL_HOST:PORT","rtgsUrl":"https://RTGS_HOST:PORT","ddaccUrl":"https://DDACC_HOST:PORT"}}
