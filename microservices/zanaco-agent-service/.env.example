# Zanaco API + worker: copy to .env; npm start launches the API and worker together.
PORT=4003
APP_API_URL=http://127.0.0.1:3000
# Match these portal values. Audit key enables worker events in the portal audit log.
BANK_PULL_API_KEY=
AGENT_AUDIT_API_KEY=

# Required Redis recovery/checkpoint store. API and worker must use the same store.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
ZANACO_QUEUE_NAME=zanaco-payments

# Required bank-issued ZWS settings. Replace UAT URL for production onboarding.
ZANACO_BASE_URL=https://uat-zws.zanaco.co.zm
ZANACO_API_KEY=
ZANACO_ACCESS_KEY=
ZANACO_API_SECRET=
# PEM contents, NOT file paths. Double quotes decode literal \n escapes.
ZANACO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PARTNER_RSA_PRIVATE_KEY\n-----END PRIVATE KEY-----"
ZANACO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_BANK_RSA_PUBLIC_KEY\n-----END PUBLIC KEY-----"
ZANACO_REQUIRE_RESPONSE_SIGNATURE=true

# Optional operational defaults.
AGENT_ID=zanaco-agent
PORTAL_CLAIM_INTERVAL_MS=5000
ZANACO_WORKER_CONCURRENCY=3
JOB_ATTEMPTS=10
JOB_BACKOFF_MS=60000
JSON_LIMIT=5mb
ZANACO_REQUEST_TIMEOUT_MS=90000
ZANACO_TOKEN_REFRESH_SKEW_MS=120000
ZANACO_ACCESS_TOKEN_TTL_MS=1800000

# Optional shared HTTP diagnostics (defaults shown).
HTTP_LOG_ENABLED=true
HTTP_LOG_BODIES=true
HTTP_LOG_MAX_BODY_BYTES=262144
HTTP_LOG_BODY_TIMEOUT_MS=10000
