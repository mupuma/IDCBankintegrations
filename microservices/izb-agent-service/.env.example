# IZB bank-facing proxy: copy to .env and run from this service directory.
# No Redis, bank client credentials or Sage settings are used by npm start.
PORT=4101
APP_API_URL=http://127.0.0.1:3000
# Shared portal key: must match portal BANK_PULL_API_KEY.
BANK_PULL_API_KEY=
# Bank-facing key: provide this separate key to IZB for its x-api-key header.
AGENT_API_KEY=

# Optional local file path. The service needs a writable data directory.
DB_PATH=./izb-agent-db.json

# Optional shared HTTP diagnostics (defaults shown).
HTTP_LOG_ENABLED=true
HTTP_LOG_BODIES=true
HTTP_LOG_MAX_BODY_BYTES=262144
HTTP_LOG_BODY_TIMEOUT_MS=10000
