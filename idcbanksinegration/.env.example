# MASTER portal: copy to .env.local for npm/Next.js deployment.
# Required: replace blank secrets and server/account placeholders before startup.
# See docs/bank-environment-deployment.md for matching agent settings.

# Portal session and first administrator (production uses HTTPS).
JWT_SECRET=
SESSION_MAX_AGE_SECONDS=3600
SESSION_COOKIE_SECURE=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_ROLE=ADMIN

# Portal MySQL database. DB_SYNC=true performs add-only schema sync.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=PORTAL_DB_USER
DB_PASSWORD=
DB_NAME=host2host
DB_SYNC=true

# Sage SQL Server: reads only; no bank agent needs Sage credentials.
SAGE_DB_HOST=SAGE_SQL_SERVER
SAGE_DB_PORT=1433
SAGE_DB_USER=SAGE_READ_USER
SAGE_DB_PASSWORD=
SAGE_DB_NAME=SAGE_COMPANY_DATABASE
SAGE_DB_ENCRYPT=true
SAGE_DB_TRUST_CERT=false
SAGE_DB_REQUEST_TIMEOUT_MS=60000
SAGE_DB_CONNECT_TIMEOUT_MS=30000
# Optional schema override for legacy vendor bank reads; blank uses discovery.
SAGE_VENBANK_SCHEMA=
# Optional mapping of vendor bank optional fields; defaults are built into the portal.
SAGE_VENDOR_BANK_OPTIONAL_FIELDS={}

# IZB and Zanaco portal communication. Use the same value in both agents.
BANK_PULL_API_KEY=
# Match the Zanaco agent setting to enable its portal audit events.
AGENT_AUDIT_API_KEY=

# Zanaco default dispatch: portal sends to the agent HTTP /payments route.
ZANACO_DISPATCH_STRATEGY=portal-push
ZANACO_BANK_API_URL=http://127.0.0.1:4003/payments
# Alternative: agent-pull uses the worker's portal claims; no bank API URL needed.

# ZICB H2H portal configuration.
# Use the same shared key as ZICB_H2H_AGENT_KEY in the ZICB agent .env.
ZICB_H2H_AGENT_KEY=

# Replace SOURCE_CODE with the exact source account code shown in Source Accounts.
# Each profileId must exactly match a key in the agent's ZICB_H2H_PROFILES.
# Region, currency, amountScale and channels must be approved for that account.
# Multiple source codes may share a profileId; add a JSON entry for each account.
# Channel names: INTERNAL, RTGS, DDACC. Include only bank-enabled channels.
ZICB_H2H_SOURCE_PROFILES='{"SOURCE_CODE":{"profileId":"institution-uat","regionCode":"BANK_APPROVED_REGION","currency":"ZMW","amountScale":2,"channels":["RTGS","DDACC"]}}'

# Optional reconciliation interval in milliseconds; minimum/default is 60000.
ZICB_H2H_RECONCILE_MS=60000

# H2H is the current ZICB flow; ZICB_H2H_ENABLED is not a runtime switch.
# Bank client credentials, service URLs and callback credentials belong in the
# agent .env, not here: ZICB_H2H_PROFILES, ZICB_H2H_WEBHOOK_USERNAME,
# ZICB_H2H_WEBHOOK_PASSWORD and ZICB_H2H_WEBHOOK_SIGNING_KEY.

# Optional portal queue recovery controls (defaults shown).
AGENT_CALLBACK_TIMEOUT_MS=120000
QUEUE_RECOVERY_BATCH_SIZE=10
