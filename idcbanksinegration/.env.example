# Auth (required for login + middleware)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h
# Set false when running production build over plain HTTP (no TLS)
SESSION_COOKIE_SECURE=false

# External MySQL (central app) settings
DB_HOST=your.mysql.host
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=host2host

# External Sage MSSQL settings
SAGE_DB_HOST=your.sage.db.host
SAGE_DB_PORT=1433
SAGE_DB_USER=sa
SAGE_DB_PASSWORD=your_sapassword
SAGE_DB_NAME=INDCOM

# Redis (used by agents). If you have an external redis set host/port here.
REDIS_HOST=redis
REDIS_PORT=6379

# ZICB agent settings (optional)
ZICB_PORT=4001

# White-label agent onboarding (portal only; existing bank agents retain their envs)
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key outside MySQL and back it up securely. Changing it requires re-onboarding.
BANK_AGENT_CONFIG_KEY=
# Exact agent HTTPS origins, comma-separated; entered URLs cannot add other hosts.
BANK_AGENT_ALLOWED_ORIGINS=https://agent.example.com
BANK_AGENT_ALLOW_LOOPBACK_HTTP=false
# Enable only behind a trusted TLS proxy that overwrites X-Forwarded-Proto and blocks direct access.
BANK_AGENT_TRUST_PROXY=false
