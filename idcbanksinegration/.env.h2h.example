# Keep disabled until the migration and ZICB UAT onboarding are complete.
ZICB_H2H_ENABLED=false
ZICB_H2H_AGENT_KEY=
ZICB_H2H_WEBHOOK_USERNAME=
ZICB_H2H_WEBHOOK_PASSWORD=
ZICB_H2H_WEBHOOK_SIGNING_KEY=
# Exact Internal FT paths must be confirmed by ZICB, starting /api/v1/bank/.
ZICB_H2H_INTERNAL_AUTH_PATH=
ZICB_H2H_INTERNAL_CALLBACK_PATH=
# Operational default only. Confirm ZICB's actual polling limit.
ZICB_H2H_RECONCILE_MS=7200000
# Keys are existing source-bank codes. Region, currency, scale and enabled
# channels must match the institution's bank onboarding configuration.
ZICB_H2H_SOURCE_PROFILES={"SOURCE_CODE":{"profileId":"institution-uat","regionCode":"BANK_CONFIRMED_REGION","currency":"ZMW","amountScale":2,"channels":["RTGS","DDACC"],"cashbookAccount":"SAGE_GL_ACCOUNT"}}
